<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.property.mapper.FeeMapper">

    <resultMap id="feeResultMap" type="Fee">
        <id property="id" column="id"/>
        <result property="ownerId" column="owner_id"/>
        <result property="houseId" column="house_id"/>
        <result property="feeType" column="fee_type"/>
        <result property="amount" column="amount"/>
        <result property="shouldPayDate" column="should_pay_date"/>
        <result property="paidDate" column="paid_date"/>
        <result property="status" column="status"/>
        <result property="ownerName" column="owner_name"/>
        <result property="houseInfo" column="house_info"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 公共查询字段 + JOIN -->
    <sql id="selectColumns">
        SELECT f.id, f.owner_id, f.house_id, f.fee_type, f.amount, f.should_pay_date, f.paid_date,
               f.status, f.created_at, f.updated_at, o.name AS owner_name,
               CONCAT(h.building, '-', h.unit, '-', h.room_number) AS house_info
        FROM fee f
        LEFT JOIN owner o ON f.owner_id = o.id
        LEFT JOIN house h ON f.house_id = h.id
    </sql>

    <!-- 公共 WHERE 条件（带表别名） -->
    <sql id="whereClause">
        <where>
            <if test="ownerId != null">AND f.owner_id = #{ownerId}</if>
            <if test="feeType != null and feeType != ''">AND f.fee_type = #{feeType}</if>
            <if test="status != null and status != ''">AND f.status = #{status}</if>
        </where>
    </sql>

    <select id="selectById" resultMap="feeResultMap">
        <include refid="selectColumns"/>
        WHERE f.id = #{id}
    </select>

    <select id="selectAll" resultMap="feeResultMap">
        <include refid="selectColumns"/>
        ORDER BY f.id DESC
    </select>

    <select id="selectByCondition" resultMap="feeResultMap">
        <include refid="selectColumns"/>
        <include refid="whereClause"/>
        ORDER BY f.id DESC
    </select>

    <select id="selectByPage" resultMap="feeResultMap">
        <include refid="selectColumns"/>
        <include refid="whereClause"/>
        ORDER BY f.id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectCount" resultType="int">
        SELECT COUNT(*) FROM fee f
        <include refid="whereClause"/>
    </select>

    <!-- 查询全部记录数（无条件） -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM fee
    </select>

    <select id="selectByOwnerId" resultMap="feeResultMap">
        <include refid="selectColumns"/>
        WHERE f.owner_id = #{ownerId}
    </select>

    <select id="countByOwnerId" resultType="int">
        SELECT COUNT(*) FROM fee WHERE owner_id = #{ownerId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO fee (owner_id, house_id, fee_type, amount, should_pay_date, paid_date, status, created_at, updated_at)
        VALUES (#{ownerId}, #{houseId}, #{feeType}, #{amount}, #{shouldPayDate}, #{paidDate}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE fee
        <set>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="houseId != null">house_id = #{houseId},</if>
            <if test="feeType != null">fee_type = #{feeType},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="shouldPayDate != null">should_pay_date = #{shouldPayDate},</if>
            <if test="paidDate != null">paid_date = #{paidDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM fee WHERE id = #{id}
    </delete>
</mapper>
