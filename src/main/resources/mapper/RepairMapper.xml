<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.property.mapper.RepairMapper">

    <resultMap id="repairResultMap" type="Repair">
        <id property="id" column="id"/>
        <result property="ownerId" column="owner_id"/>
        <result property="deviceName" column="device_name"/>
        <result property="faultDescription" column="fault_description"/>
        <result property="repairEmployeeId" column="repair_employee_id"/>
        <result property="status" column="status"/>
        <result property="completedAt" column="completed_at"/>
        <result property="ownerName" column="owner_name"/>
        <result property="repairEmployeeName" column="repair_employee_name"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="selectColumns">
        SELECT r.id, r.owner_id, r.device_name, r.fault_description, r.repair_employee_id,
               r.status, r.completed_at, r.created_at, r.updated_at,
               o.name AS owner_name, e.name AS repair_employee_name
        FROM repair r
        LEFT JOIN owner o ON r.owner_id = o.id
        LEFT JOIN employee e ON r.repair_employee_id = e.id
    </sql>

    <sql id="whereClause">
        <where>
            <if test="ownerId != null">AND r.owner_id = #{ownerId}</if>
            <if test="status != null and status != ''">AND r.status = #{status}</if>
        </where>
    </sql>

    <select id="selectById" resultMap="repairResultMap">
        <include refid="selectColumns"/>
        WHERE r.id = #{id}
    </select>

    <select id="selectAll" resultMap="repairResultMap">
        <include refid="selectColumns"/>
        ORDER BY r.id DESC
    </select>

    <select id="selectByCondition" resultMap="repairResultMap">
        <include refid="selectColumns"/>
        <include refid="whereClause"/>
        ORDER BY r.id DESC
    </select>

    <select id="selectByPage" resultMap="repairResultMap">
        <include refid="selectColumns"/>
        <include refid="whereClause"/>
        ORDER BY r.id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectCount" resultType="int">
        SELECT COUNT(*) FROM repair r
        <include refid="whereClause"/>
    </select>

    <!-- 查询全部记录数（无条件） -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM repair
    </select>

    <select id="selectByOwnerId" resultMap="repairResultMap">
        <include refid="selectColumns"/>
        WHERE r.owner_id = #{ownerId}
    </select>

    <select id="countByOwnerId" resultType="int">
        SELECT COUNT(*) FROM repair WHERE owner_id = #{ownerId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO repair (owner_id, device_name, fault_description, repair_employee_id, status, created_at, updated_at)
        VALUES (#{ownerId}, #{deviceName}, #{faultDescription}, #{repairEmployeeId}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE repair
        <set>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="deviceName != null">device_name = #{deviceName},</if>
            <if test="faultDescription != null">fault_description = #{faultDescription},</if>
            <if test="repairEmployeeId != null">repair_employee_id = #{repairEmployeeId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="completedAt != null">completed_at = #{completedAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM repair WHERE id = #{id}
    </delete>
</mapper>
