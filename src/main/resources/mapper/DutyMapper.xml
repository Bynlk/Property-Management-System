<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.property.mapper.DutyMapper">

    <resultMap id="dutyResultMap" type="Duty">
        <id property="id" column="id"/>
        <result property="employeeId" column="employee_id"/>
        <result property="dutyDate" column="duty_date"/>
        <result property="shift" column="shift"/>
        <result property="employeeName" column="employee_name"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="selectColumns">
        SELECT d.*, e.name AS employee_name
        FROM duty d LEFT JOIN employee e ON d.employee_id = e.id
    </sql>

    <sql id="whereClause">
        <where>
            <if test="employeeId != null">AND d.employee_id = #{employeeId}</if>
            <if test="shift != null and shift != ''">AND d.shift = #{shift}</if>
        </where>
    </sql>

    <select id="selectById" resultMap="dutyResultMap">
        <include refid="selectColumns"/>
        WHERE d.id = #{id}
    </select>

    <select id="selectByCondition" resultMap="dutyResultMap">
        <include refid="selectColumns"/>
        <include refid="whereClause"/>
        ORDER BY d.id DESC
    </select>

    <select id="selectByPage" resultMap="dutyResultMap">
        <include refid="selectColumns"/>
        <include refid="whereClause"/>
        ORDER BY d.id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectCount" resultType="int">
        SELECT COUNT(*) FROM duty
        <where>
            <if test="employeeId != null">AND employee_id = #{employeeId}</if>
            <if test="shift != null and shift != ''">AND shift = #{shift}</if>
        </where>
    </select>

    <select id="countByEmployeeId" resultType="int">
        SELECT COUNT(*) FROM duty WHERE employee_id = #{employeeId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO duty (employee_id, duty_date, shift, created_at, updated_at)
        VALUES (#{employeeId}, #{dutyDate}, #{shift}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE duty
        <set>
            <if test="employeeId != null">employee_id = #{employeeId},</if>
            <if test="dutyDate != null">duty_date = #{dutyDate},</if>
            <if test="shift != null">shift = #{shift},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM duty WHERE id = #{id}
    </delete>
</mapper>
