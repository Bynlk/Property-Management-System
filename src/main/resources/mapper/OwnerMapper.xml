<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.property.mapper.OwnerMapper">

    <!-- 结果映射 -->
    <resultMap id="ownerResultMap" type="Owner">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="gender" column="gender"/>
        <result property="phone" column="phone"/>
        <result property="idCard" column="id_card"/>
        <result property="moveInDate" column="move_in_date"/>
    </resultMap>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="ownerResultMap">
        SELECT * FROM owner WHERE id = #{id}
    </select>

    <!-- 模糊查询 -->
    <select id="selectByCondition" resultMap="ownerResultMap">
        SELECT * FROM owner
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <!-- 查询所有 -->
    <select id="selectAll" resultMap="ownerResultMap">
        SELECT * FROM owner ORDER BY id DESC
    </select>

    <!-- 分页查询 -->
    <select id="selectByPage" resultMap="ownerResultMap">
        SELECT * FROM owner
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- 查询总记录数 -->
    <select id="selectCount" resultType="int">
        SELECT COUNT(*) FROM owner
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
        </where>
    </select>

    <!-- 新增 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO owner (name, gender, phone, id_card, move_in_date)
        VALUES (#{name}, #{gender}, #{phone}, #{idCard}, #{moveInDate})
    </insert>

    <!-- 修改 -->
    <update id="update">
        UPDATE owner
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="moveInDate != null">move_in_date = #{moveInDate},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除 -->
    <delete id="deleteById">
        DELETE FROM owner WHERE id = #{id}
    </delete>

</mapper>
