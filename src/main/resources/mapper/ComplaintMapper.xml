<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.property.mapper.ComplaintMapper">

    <resultMap id="complaintResultMap" type="Complaint">
        <id property="id" column="id"/>
        <result property="ownerId" column="owner_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="resolvedAt" column="resolved_at"/>
        <result property="ownerName" column="owner_name"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 公共查询字段 + JOIN -->
    <sql id="selectColumns">
        SELECT c.id, c.owner_id, c.title, c.content, c.status, c.resolved_at,
               c.created_at, c.updated_at, o.name AS owner_name
        FROM complaint c LEFT JOIN owner o ON c.owner_id = o.id
    </sql>

    <!-- 公共 WHERE 条件（带表别名） -->
    <sql id="whereClause">
        <where>
            <if test="ownerId != null">AND c.owner_id = #{ownerId}</if>
            <if test="status != null and status != ''">AND c.status = #{status}</if>
        </where>
    </sql>

    <select id="selectById" resultMap="complaintResultMap">
        <include refid="selectColumns"/>
        WHERE c.id = #{id}
    </select>

    <select id="selectAll" resultMap="complaintResultMap">
        <include refid="selectColumns"/>
        ORDER BY c.id DESC
    </select>

    <select id="selectByCondition" resultMap="complaintResultMap">
        <include refid="selectColumns"/>
        <include refid="whereClause"/>
        ORDER BY c.id DESC
    </select>

    <select id="selectByPage" resultMap="complaintResultMap">
        <include refid="selectColumns"/>
        <include refid="whereClause"/>
        ORDER BY c.id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectCount" resultType="int">
        SELECT COUNT(*) FROM complaint c
        <include refid="whereClause"/>
    </select>

    <!-- 查询全部记录数（无条件） -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM complaint
    </select>

    <select id="selectByOwnerId" resultMap="complaintResultMap">
        <include refid="selectColumns"/>
        WHERE c.owner_id = #{ownerId}
    </select>

    <select id="countByOwnerId" resultType="int">
        SELECT COUNT(*) FROM complaint WHERE owner_id = #{ownerId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO complaint (owner_id, title, content, status, created_at, updated_at)
        VALUES (#{ownerId}, #{title}, #{content}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE complaint
        <set>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="status != null">status = #{status},</if>
            <if test="resolvedAt != null">resolved_at = #{resolvedAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM complaint WHERE id = #{id}
    </delete>
</mapper>
