<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.property.mapper.ParkingMapper">

    <resultMap id="parkingResultMap" type="Parking">
        <id property="id" column="id"/>
        <result property="spotNumber" column="spot_number"/>
        <result property="licensePlate" column="license_plate"/>
        <result property="ownerId" column="owner_id"/>
        <result property="status" column="status"/>
        <result property="ownerName" column="owner_name"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="selectColumns">
        SELECT p.id, p.spot_number, p.license_plate, p.owner_id, p.status,
               p.created_at, p.updated_at, o.name AS owner_name
        FROM parking p LEFT JOIN owner o ON p.owner_id = o.id
    </sql>

    <sql id="whereClause">
        <where>
            <if test="spotNumber != null and spotNumber != ''">
                AND p.spot_number LIKE CONCAT('%', #{spotNumber}, '%')
            </if>
            <if test="status != null and status != ''">
                AND p.status = #{status}
            </if>
        </where>
    </sql>

    <select id="selectById" resultMap="parkingResultMap">
        <include refid="selectColumns"/>
        WHERE p.id = #{id}
    </select>

    <select id="selectAll" resultMap="parkingResultMap">
        <include refid="selectColumns"/>
        ORDER BY p.id DESC
    </select>

    <select id="selectByCondition" resultMap="parkingResultMap">
        <include refid="selectColumns"/>
        <include refid="whereClause"/>
        ORDER BY p.id DESC
    </select>

    <select id="selectByPage" resultMap="parkingResultMap">
        <include refid="selectColumns"/>
        <include refid="whereClause"/>
        ORDER BY p.id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectCount" resultType="int">
        SELECT COUNT(*) FROM parking p
        <include refid="whereClause"/>
    </select>

    <select id="selectByOwnerId" resultMap="parkingResultMap">
        <include refid="selectColumns"/>
        WHERE p.owner_id = #{ownerId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO parking (spot_number, license_plate, owner_id, status, created_at, updated_at)
        VALUES (#{spotNumber}, #{licensePlate}, #{ownerId}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE parking
        <set>
            <if test="spotNumber != null">spot_number = #{spotNumber},</if>
            <if test="licensePlate != null">license_plate = #{licensePlate},</if>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM parking WHERE id = #{id}
    </delete>
</mapper>
